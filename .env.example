# Website Pipeline API - Environment Variables
#
# Copy to .env and fill in only the providers you use. Leave a key empty when
# you do not have it: an empty key fails that provider at once and the gateway
# moves to the next one in the chain. A placeholder value would be sent to the
# vendor as if it were real.
#
# Model names are retired over time. When a call fails with "model not found",
# check the vendor's model page and change the *_MODEL value.

# Google AI (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Anthropic (Claude). The provider name in the chains below is 'claude'.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Anthropic output token limit per call
ANTHROPIC_MAX_TOKENS=8192

# LLM provider failover chains, in order of preference.
# Each agent tries the first provider, retries it on transient errors, and
# then moves to the next one. Names: gemini | openai | claude
ARCHITECT_LLM_CHAIN=gemini,openai
BUILDER_LLM_CHAIN=gemini,openai
# The older single provider variables still work when no chain is set:
# ARCHITECT_LLM_PROVIDER=gemini
# BUILDER_LLM_PROVIDER=gemini

# LLM gateway behaviour
LLM_MAX_ATTEMPTS=3          # calls per provider before failing over
LLM_BASE_DELAY_MS=500       # first backoff ceiling, doubles each attempt
LLM_MAX_DELAY_MS=8000       # upper bound for one wait
LLM_TIMEOUT_MS=120000       # a call longer than this is aborted

# Quality gate
MAX_REPAIR_ATTEMPTS=1       # extra Builder calls when the HTML fails the gate
# ALLOWED_SCRIPT_HOSTS=cdn.tailwindcss.com,cdn.jsdelivr.net,unpkg.com,cdnjs.cloudflare.com

# Idempotency: how long a successful run answers identical requests (0 disables)
IDEMPOTENCY_TTL_SECONDS=86400

# API authentication. When set, every route except /health needs this value
# in the x-api-key header. Leave empty for local development only.
PIPELINE_API_KEY=

# Server Configuration
PORT=4000

# Supabase Configuration
# Leave empty to run without uploads (use ?skipUpload=true).
# Example URL: https://your-project.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Example: postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=
